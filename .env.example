# Non-secret settings only. Never put AWS keys here:
# boto3 reads credentials from ~/.aws (select a profile with AWS_PROFILE).
AWS_PROFILE=default

AWS_REGION=eu-central-1

EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024
LLM_MODEL_ID=eu.amazon.nova-2-lite-v1:0

QDRANT_URL=http://localhost:6333
COLLECTION_NAME=palg_all7

PDF_PATH=data/protokol_palg_all7.pdf
CHUNKS_PATH=data/chunks.jsonl
EXCLUDED_PAGES=[1,2,3,4]
CHUNK_TOKENIZER=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_MAX_TOKENS=500
DOCLING_DEVICE=cpu

TOP_K=5
RETRIEVAL_MODE=dense
RERANK_ENABLED=false
RERANK_MODEL_ID=cohere.rerank-v3-5:0
RERANK_FETCH_K=20

LOG_LEVEL=INFO
